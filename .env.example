APP_NAME=BiraConsultant
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local development uses SQLite. Create the file before running migrations.
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

# Optional: set a private local-only password before running the demo seeder.
BIRA_DEMO_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
